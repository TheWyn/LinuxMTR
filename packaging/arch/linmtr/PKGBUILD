# Maintainer: Wyn <TheWyn@users.noreply.github.com>

pkgname=linmtr
pkgver=0.1.0
pkgrel=1
pkgdesc='Qt 6 port of WinMTR: graphical traceroute and ping network diagnostic tool'
arch=(x86_64)
url='https://github.com/TheWyn/LinuxMTR'
# Upstream WinMTR grants "GPL V2" without "or any later version", and LinMTR
# reproduces its strings and report formats: version 2 only.
license=(GPL-2.0-only)
# Use libgcc and libstdc++, not the gcc-libs meta package, which now also
# pulls in unrelated runtimes (qt6-base declares them the same way).
# hicolor-icon-theme owns the icon directory tree that the icon goes into.
depends=(qt6-base glibc libgcc libstdc++ hicolor-icon-theme)
makedepends=(cmake)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1e268798ad5b8b1571e764c48c04b5b885413fb1bf571e96136f5e70b1dc4c1f')

build() {
  cmake -S "LinuxMTR-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  # The tests wait on timers, not on the CPU, so 32 jobs help on any core count.
  ctest --test-dir build --output-on-failure -j 32
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
