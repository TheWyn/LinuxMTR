# One ctest entry per test function, so that ctest -j runs the slow session tests side by side.
execute_process(COMMAND "${TEST_EXE}" -functions OUTPUT_VARIABLE out RESULT_VARIABLE rc)
string(REPLACE "\n" ";" functions "${out}")
list(FILTER functions INCLUDE REGEX "^[A-Za-z_][A-Za-z0-9_]*\\(\\)$")
if(NOT rc EQUAL 0 OR NOT functions)
    message(FATAL_ERROR "\"${TEST_EXE}\" -functions failed (${rc}): ${out}")
endif()
get_filename_component(suite "${TEST_EXE}" NAME_WE)
set(tests "")
foreach(function IN LISTS functions)
    string(REPLACE "()" "" function "${function}")
    string(APPEND tests "add_test([==[${suite}.${function}]==] [==[${TEST_EXE}]==] ${function})\n")
endforeach()
file(WRITE "${OUT}" "${tests}")
